# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=api_movies
DB_NAME_TEST=api_movies_test
DB_PORT=3306
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000

# Autenticacion
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
APP_URL=http://localhost:8089

# Rate limiter
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_WRITE=30
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_USER=500
RATE_LIMIT_USER_WINDOW_MS=60000

# Penalty box
RATE_LIMIT_PENALTY_THRESHOLD_GLOBAL=50
RATE_LIMIT_PENALTY_THRESHOLD_AUTH=10
RATE_LIMIT_PENALTY_THRESHOLD_WRITE=30
RATE_LIMIT_PENALTY_THRESHOLD_USER=100
RATE_LIMIT_PENALTY_WINDOW_MS=300000
RATE_LIMIT_PENALTY_DURATION_MS=900000

# Proxy y fail-open
TRUST_PROXY=false
RATE_LIMIT_FAIL_OPEN=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6379/15

# Cache
CACHE_ENABLED=true
CACHE_TTL_MOVIES=300
CACHE_TTL_GENRES=300

# Email (F2). Sin RESEND_API_KEY el worker loguea el correo en vez de enviarlo.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_DELIVERY_MODE=queue
EMAIL_WORKER_CONCURRENCY=2
EMAIL_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_DURATION_MS=1000
EMAIL_ENQUEUE_TIMEOUT_MS=3000

# Meilisearch
MEILISEARCH_ENABLED=false
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
