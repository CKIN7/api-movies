DB_PASSWORD=697596
DB_NAME=moviesdb
DB_PORT=3306

# JWT
JWT_SECRET=7f8a9b2c4d6e1f3a5b7c9d1e3f5a7b9c1d3e5f7a9b1c3d5e7f9a1b3c5d7e9f1a
JWT_REFRESH_SECRET=8f9a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8d0e2f4a6b8c0d2e4f6a8b0c2d4e6f8a0

# APP
APP_URL=http://localhost:8089

# Redis Rate Limiter
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_WRITE=30
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_USER=500
RATE_LIMIT_USER_WINDOW_MS=60000

# Penalty Box (activado tras X rechazos 429 en 5 min)
RATE_LIMIT_PENALTY_THRESHOLD_GLOBAL=50
RATE_LIMIT_PENALTY_THRESHOLD_AUTH=10
RATE_LIMIT_PENALTY_THRESHOLD_WRITE=30
RATE_LIMIT_PENALTY_THRESHOLD_USER=100
RATE_LIMIT_PENALTY_WINDOW_MS=300000
RATE_LIMIT_PENALTY_DURATION_MS=900000

# Proxy / Fail-open
TRUST_PROXY=false
RATE_LIMIT_FAIL_OPEN=true

# Redis Caching Layer
CACHE_ENABLED=true
CACHE_TTL_MOVIES=60
CACHE_TTL_GENRES=300